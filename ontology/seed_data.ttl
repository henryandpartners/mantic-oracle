    rdfs:label "Ogbe-Oyeku" ;
    mantic:figureIndex 2 ;
    mantic:hasBinaryVector "11110000" ;
    mantic:leftLeg "Ogbe" ;
    mantic:parable "Left leg Ogbe leads: Light at fullness: destiny aligned - proceed without arrogance; the bright road punishes pride. || Right leg Oyeku modifies: Darkness at fullness: the ancestor road closes a cycle - retreat honors what opens next." ;
    mantic:rightLeg "Oyeku" .

