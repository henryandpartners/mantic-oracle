    mantic:lowerTrigram "Qian" ;
    mantic:parable "Dense clouds, no rain: the small gentles the strong without toppling it. Prepare; do not launch." ;
    mantic:upperTrigram "Xun" .

mantic:Hex10 a mantic:IChingHexagram ;
