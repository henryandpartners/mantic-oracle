    mantic:figureIndex 3 ;
    mantic:hasBinaryVector "0111" ;
    mantic:keyword "earned victory" ;
    mantic:parable "Sun behind the wall: victory earned through patient strength - help arrives from what you cannot command." ;
    mantic:planet "Sun" ;
