    mantic:dominatesElement mantic:ElemFire ;
    mantic:element "Fire" ;
    mantic:figureIndex 9 ;
    mantic:hasBinaryVector "1011" ;
    mantic:keyword "impetuous strength" ;
    mantic:parable "The drawn blade of youth: courage without patience; cut once, then sheath." ;
    mantic:planet "Mars" ;
    mantic:sharesArchetypeWith mantic:Hex34,
        mantic:Odu222 .

mantic:FigRubeus a mantic:GeomanticSign ;
