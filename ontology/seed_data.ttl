    mantic:figureIndex 4 ;
    mantic:hasBinaryVector "1110" ;
    mantic:keyword "swift luck" ;
    mantic:parable "The swift flame: quick gain by cleverness - secure it now, it will not hold." ;
    mantic:planet "Sun" ;
    mantic:sharesArchetypeWith mantic:Hex12,
        mantic:Odu086 .

mantic:FigLaetitia a mantic:GeomanticSign ;
    rdfs:label "Laetitia" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 7 ;
    mantic:hasBinaryVector "0001" ;
    mantic:keyword "joy rising" ;
    mantic:parable "A single spark at the base: joy rises like sap - protect the small fire and let it climb." ;
