    mantic:lowerTrigram "Dui" ;
    mantic:parable "Step on the tiger's tail: conduct, not courage, survives proximity to power." ;
    mantic:upperTrigram "Qian" .

mantic:Hex13 a mantic:IChingHexagram ;
