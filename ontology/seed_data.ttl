@prefix mantic: <https://w3id.org/mantic/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mantic:FigAcquisitio a mantic:GeomanticSign ;
    rdfs:label "Acquisitio" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 5 ;
    mantic:hasBinaryVector "0011" ;
    mantic:keyword "gain" ;
    mantic:parable "The rising cup: gain gathers to the low and open hand; receive without gripping." ;
    mantic:planet "Jupiter" ;
    mantic:sharesArchetypeWith mantic:Hex14,
        mantic:Odu154 .

mantic:FigAlbus a mantic:GeomanticSign ;
    rdfs:label "Albus" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 11 ;
    mantic:hasBinaryVector "1010" ;
    mantic:keyword "clear thought" ;
    mantic:parable "The clear goblet: thought purified - withdraw into counsel; do not act on heat." ;
    mantic:planet "Mercury" ;
    mantic:sharesArchetypeWith mantic:Hex20,
        mantic:Odu188 .

mantic:FigAmissio a mantic:GeomanticSign ;
    rdfs:label "Amissio" ;
    mantic:dominatesElement mantic:ElemWater ;
    mantic:element "Water" ;
    mantic:figureIndex 6 ;
    mantic:hasBinaryVector "1100" ;
    mantic:keyword "loss" ;
    mantic:parable "The funnel: loss through the narrow top - release the perishable before it prices itself." ;
    mantic:planet "Venus" ;
    mantic:sharesArchetypeWith mantic:Hex41,
        mantic:Odu137 .

mantic:FigCaputDraconis a mantic:GeomanticSign ;
    rdfs:label "Caput Draconis" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 15 ;
    mantic:hasBinaryVector "0010" ;
    mantic:keyword "ingress" ;
    mantic:parable "The door opening inward: beginnings permitted - enter with the tide." ;
    mantic:planet "North Node" ;
    mantic:sharesArchetypeWith mantic:Hex24,
        mantic:Odu120 .

mantic:FigCarcer a mantic:GeomanticSign ;
    rdfs:label "Carcer" ;
    mantic:dominatesElement mantic:ElemEarth ;
    mantic:element "Earth" ;
    mantic:figureIndex 14 ;
    mantic:hasBinaryVector "0110" ;
    mantic:keyword "containment" ;
    mantic:parable "The cage of law: what encloses also defines - name the constraint precisely to unlock it." ;
    mantic:planet "Saturn" ;
    mantic:resolvesAmbiguity mantic:Deadlock ;
    mantic:sharesArchetypeWith mantic:Hex60,
        mantic:Odu052 .

mantic:FigCaudaDraconis a mantic:GeomanticSign ;
