mantic:FigVia a mantic:GeomanticSign ;
    rdfs:label "Via" ;
    mantic:dominatesElement mantic:ElemWater ;
    mantic:element "Water" ;
    mantic:figureIndex 1 ;
    mantic:hasBinaryVector "1111" ;
    mantic:keyword "passage" ;
    mantic:parable "The straight road: pure momentum with nothing carried - move, but do not mistake speed for direction." ;
    mantic:planet "Moon" ;
    mantic:resolvesAmbiguity mantic:ParetoFlat ;
    mantic:sharesArchetypeWith mantic:Hex01,
        mantic:Odu001 .

mantic:Odu002 a mantic:IfaOdu ;
    rdfs:label "Ogbe-Oyeku" ;
    mantic:figureIndex 2 ;
    mantic:hasBinaryVector "11110000" ;
    mantic:leftLeg "Ogbe" ;
    mantic:parable "Ogbe rises first — light at its first opening — and sets the stage of beginnings, clarity, the uncarried day. Over it walks Oyeku, the closing gate: Rises and extends, the reading now withdraws and gathers. The danger here is light that ignores the shadow exhausts itself by noon; the working gift is peace made with what is finished. \"However long the night, the dawn arrives without knocking. Yet every open road remembers where it closed.\"" ;
    mantic:rightLeg "Oyeku" .

mantic:Odu003 a mantic:IfaOdu ;
    rdfs:label "Ogbe-Iwori" ;
    mantic:figureIndex 3 ;
    mantic:hasBinaryVector "11111001" ;
    mantic:leftLeg "Ogbe" ;
    mantic:parable "Ogbe rises first — light at its first opening — and sets the stage of beginnings, clarity, the uncarried day. Over it walks Iwori, the witness between two banks: Rises and extends, the reading now turns and returns. The danger here is light that ignores the shadow exhausts itself by noon; the working gift is the eye that judges itself first. \"However long the night, the dawn arrives without knocking. Yet the witness sees what the traveler cannot.\"" ;
    mantic:rightLeg "Iwori" .

mantic:Odu004 a mantic:IfaOdu ;
