    mantic:dominatesElement mantic:ElemFire ;
    mantic:element "Fire" ;
    mantic:figureIndex 12 ;
    mantic:hasBinaryVector "0101" ;
    mantic:keyword "passion clouding" ;
    mantic:parable "The red vapor: passion at the feet of reason - postpone the irreversible." ;
    mantic:planet "Mars" ;
