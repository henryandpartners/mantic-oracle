    rdfs:label "Ogbe-Obara" ;
    mantic:figureIndex 7 ;
    mantic:hasBinaryVector "11110100" ;
    mantic:leftLeg "Ogbe" ;
    mantic:parable "Ogbe rises first — light at its first opening — and sets the stage of beginnings, clarity, the uncarried day. Over it walks Obara, the scale and the coin: Rises and extends, the reading now trades and balances. The danger here is light that ignores the shadow exhausts itself by noon; the working gift is prosperity with clean hands. \"However long the night, the dawn arrives without knocking. Yet the market weighs all news in the same scale.\"" ;
    mantic:rightLeg "Obara" .

mantic:Odu008 a mantic:IfaOdu ;
