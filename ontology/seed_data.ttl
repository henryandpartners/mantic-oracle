@prefix mantic: <https://w3id.org/mantic/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mantic:FigAcquisitio a mantic:GeomanticSign ;
    rdfs:label "Acquisitio" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 5 ;
    mantic:hasBinaryVector "0011" ;
    mantic:keyword "gain" ;
    mantic:parable "The rising cup: gain gathers to the low and open hand; receive without gripping." ;
    mantic:planet "Jupiter" ;
    mantic:sharesArchetypeWith mantic:Hex14,
        mantic:Odu154 .

mantic:FigAlbus a mantic:GeomanticSign ;
    rdfs:label "Albus" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 11 ;
    mantic:hasBinaryVector "1010" ;
    mantic:keyword "clear thought" ;
    mantic:parable "The clear goblet: thought purified - withdraw into counsel; do not act on heat." ;
    mantic:planet "Mercury" ;
    mantic:sharesArchetypeWith mantic:Hex20,
        mantic:Odu188 .

mantic:FigAmissio a mantic:GeomanticSign ;
    rdfs:label "Amissio" ;
    mantic:dominatesElement mantic:ElemWater ;
    mantic:element "Water" ;
    mantic:figureIndex 6 ;
    mantic:hasBinaryVector "1100" ;
    mantic:keyword "loss" ;
    mantic:parable "The funnel: loss through the narrow top - release the perishable before it prices itself." ;
    mantic:planet "Venus" ;
    mantic:sharesArchetypeWith mantic:Hex41,
        mantic:Odu137 .

mantic:FigCaputDraconis a mantic:GeomanticSign ;
    rdfs:label "Caput Draconis" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 15 ;
    mantic:hasBinaryVector "0010" ;
    mantic:keyword "ingress" ;
    mantic:parable "The door opening inward: beginnings permitted - enter with the tide." ;
    mantic:planet "North Node" ;
    mantic:sharesArchetypeWith mantic:Hex24,
        mantic:Odu120 .

mantic:FigCarcer a mantic:GeomanticSign ;
    rdfs:label "Carcer" ;
    mantic:dominatesElement mantic:ElemEarth ;
    mantic:element "Earth" ;
    mantic:figureIndex 14 ;
    mantic:hasBinaryVector "0110" ;
    mantic:keyword "containment" ;
    mantic:parable "The cage of law: what encloses also defines - name the constraint precisely to unlock it." ;
    mantic:planet "Saturn" ;
    mantic:resolvesAmbiguity mantic:Deadlock ;
    mantic:sharesArchetypeWith mantic:Hex60,
        mantic:Odu052 .

mantic:FigCaudaDraconis a mantic:GeomanticSign ;
    rdfs:label "Cauda Draconis" ;
    mantic:dominatesElement mantic:ElemEarth ;
    mantic:element "Earth" ;
    mantic:figureIndex 16 ;
    mantic:hasBinaryVector "0100" ;
    mantic:keyword "egress" ;
    mantic:parable "The door opening outward: endings demanded - leave before you are left." ;
    mantic:planet "South Node" ;
    mantic:sharesArchetypeWith mantic:Hex33,
        mantic:Odu103 .

mantic:FigConjunctio a mantic:GeomanticSign ;
    rdfs:label "Conjunctio" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 13 ;
    mantic:hasBinaryVector "1001" ;
    mantic:keyword "union" ;
    mantic:parable "The meeting of roads: union or negotiation; combine unequal halves in the open." ;
    mantic:planet "Mercury" ;
    mantic:sharesArchetypeWith mantic:Hex61,
        mantic:Odu035 .

mantic:FigFortunaMajor a mantic:GeomanticSign ;
    rdfs:label "Fortuna Major" ;
    mantic:dominatesElement mantic:ElemFire ;
    mantic:element "Fire" ;
    mantic:figureIndex 3 ;
    mantic:hasBinaryVector "0111" ;
    mantic:keyword "earned victory" ;
    mantic:parable "Sun behind the wall: victory earned through patient strength - help arrives from what you cannot command." ;
    mantic:planet "Sun" ;
    mantic:sharesArchetypeWith mantic:Hex11,
        mantic:Odu069 .

mantic:FigFortunaMinor a mantic:GeomanticSign ;
    rdfs:label "Fortuna Minor" ;
    mantic:dominatesElement mantic:ElemFire ;
    mantic:element "Fire" ;
    mantic:figureIndex 4 ;
    mantic:hasBinaryVector "1110" ;
    mantic:keyword "swift luck" ;
    mantic:parable "The swift flame: quick gain by cleverness - secure it now, it will not hold." ;
    mantic:planet "Sun" ;
    mantic:sharesArchetypeWith mantic:Hex12,
        mantic:Odu086 .

mantic:FigLaetitia a mantic:GeomanticSign ;
    rdfs:label "Laetitia" ;
    mantic:dominatesElement mantic:ElemAir ;
    mantic:element "Air" ;
    mantic:figureIndex 7 ;
    mantic:hasBinaryVector "0001" ;
    mantic:keyword "joy rising" ;
    mantic:parable "A single spark at the base: joy rises like sap - protect the small fire and let it climb." ;
    mantic:planet "Jupiter" ;
    mantic:sharesArchetypeWith mantic:Hex46,
        mantic:Odu239 .

mantic:FigOsa mantic:resolvesAmbiguity mantic:OODSurprise .

mantic:FigPopulus a mantic:GeomanticSign ;
    rdfs:label "Populus" ;
    mantic:dominatesElement mantic:ElemWater ;
    mantic:element "Water" ;
    mantic:figureIndex 2 ;
    mantic:hasBinaryVector "0000" ;
    mantic:keyword "assembly" ;
    mantic:parable "The square full of faces: the outcome is collective and inert; wait a tide before reading the sea." ;
    mantic:planet "Moon" ;
    mantic:resolvesAmbiguity mantic:Deadlock ;
    mantic:sharesArchetypeWith mantic:Hex02,
        mantic:Odu018 .

mantic:FigPuella a mantic:GeomanticSign ;
    rdfs:label "Puella" ;
    mantic:dominatesElement mantic:ElemWater ;
    mantic:element "Water" ;
    mantic:figureIndex 10 ;
    mantic:hasBinaryVector "1101" ;
    mantic:keyword "harmonious grace" ;
    mantic:parable "The mirror of delight: harmony earned by grace; beauty binds only while sincere." ;
    mantic:planet "Venus" ;
    mantic:resolvesAmbiguity mantic:ParetoFlat ;
    mantic:sharesArchetypeWith mantic:Hex58,
        mantic:Odu205 .

