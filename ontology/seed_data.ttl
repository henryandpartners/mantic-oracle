    mantic:figureIndex 35 ;
    mantic:hasBinaryVector "10011001" ;
    mantic:leftLeg "Iwori" ;
    mantic:parable "The eye turned inward: verify the seer before the seeing; the answer observes the asker." ;
    mantic:rightLeg "Iwori" .

mantic:Odu239 a mantic:IfaOdu ;
    rdfs:label "Ose Meji" ;
    mantic:figureIndex 239 ;
    mantic:hasBinaryVector "00010001" ;
    mantic:leftLeg "Ose" ;
