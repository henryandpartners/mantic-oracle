    mantic:lowerTrigram "Kun" ;
    mantic:parable "Thunder rolls out of the earth: enthusiasm moves the many - set the direction before the drums." ;
    mantic:upperTrigram "Zhen" .

mantic:Hex17 a mantic:IChingHexagram ;
