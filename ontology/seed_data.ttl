    mantic:rightLeg "Obara" .

mantic:Odu120 a mantic:IfaOdu ;
    rdfs:label "Okanran Meji" ;
    mantic:figureIndex 120 ;
    mantic:hasBinaryVector "00100010" ;
    mantic:leftLeg "Okanran" ;
    mantic:parable "The urgent call: answer now; in delay the trap sets itself." ;
    mantic:rightLeg "Okanran" .

