@prefix mantic:   <https://w3id.org/mantic/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix vann:     <http://purl.org/vocab/vann/> .

<https://w3id.org/mantic/core> a owl:Ontology ;
    dcterms:title "Mantic Core Ontology (DVSystoE)"@en ;
    dcterms:description "Unified OWL-DL ontology for the Multi-System Mantic Oracle Engine: a neuro-symbolic decision-reframing substrate aligning Ifa (8-bit), I Ching (6-bit) and Arabic Geomancy / Sikidy (4-bit) natural computation systems into one computable archetype space."@en ;
    dcterms:creator "Fathomers / DVSystoE Project" ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "mantic" ;
    vann:preferredNamespaceUri "https://w3id.org/mantic/core#" .

#################################################################
# Classes
#################################################################

mantic:ManticFigure a owl:Class ;
    rdfs:label "Mantic Figure"@en ;
    rdfs:comment "Any discrete binary-encoded sign emitted by a Natural Computation System (NCS). The atomic unit of the oracle's knowledge space."@en .

mantic:IfaOdu a owl:Class ;
    rdfs:subClassOf mantic:ManticFigure ;
    rdfs:label "Ifa Odu"@en ;
    rdfs:comment "One of the 256 (2^8) signs of the Yoruba Ifa corpus. An 8-bit vector of two 4-bit 'legs', left leg first, each leg read top to bottom."@en .

mantic:IChingHexagram a owl:Class ;
    rdfs:subClassOf mantic:ManticFigure ;
    rdfs:label "I Ching Hexagram"@en ;
    rdfs:comment "One of the 64 (2^6) states of the Zhouyi dynamic state machine. Binary vector read bottom line (index 0) to top line (index 5)."@en .

mantic:GeomanticSign a owl:Class ;
    rdfs:subClassOf mantic:ManticFigure ;
    rdfs:label "Geomantic Sign"@en ;
    rdfs:comment "One of the 16 (2^4) figures of Arabic Geomancy / Malagasy Sikidy, generated by modulo-2 (XOR) tableau arithmetic. Binary vector read head (row 1, fire) to feet (row 4, earth); 1 = single/active row, 0 = double/passive row."@en .

mantic:GeomanticChart a owl:Class ;
    rdfs:label "Geomantic Shield Chart"@en ;
    rdfs:comment "The full 16-place derivation: 4 Mothers, 4 Daughters, 4 Nieces, 2 Witnesses, the Judge and the Reconciler."@en .

mantic:HexagramCast a owl:Class ;
    rdfs:label "Hexagram Cast"@en ;
    rdfs:comment "A dynamic I Ching state sample: six line values in {6,7,8,9}, the primary hexagram, the changing lines and the resultant hexagram."@en .

mantic:Consultation a owl:Class ;
    rdfs:label "Oracle Consultation"@en ;
    rdfs:comment "A single oracle transaction: entropy sampling, algebraic derivation, knowledge-graph traversal and strategic reframing for a consulting agent."@en .

mantic:DecisionContext a owl:Class ;
    rdfs:label "Decision Context"@en ;
    rdfs:comment "The deadlock, Pareto-flat choice set or out-of-distribution uncertainty an agent submits to the oracle."@en .

mantic:Element a owl:Class ;
    rdfs:label "Elemental Principle"@en ;
    rdfs:comment "Archetypal phase used for dominance reasoning across systems."@en .

#################################################################
# Object properties
#################################################################

mantic:sharesArchetypeWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "shares archetype with"@en ;
    rdfs:comment "Links figures across (or within) mantic systems that encode the same archetypal attractor, e.g. Via <-> Hexagram 01 Qian <-> Eji Ogbe (all-active vectors)."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range mantic:ManticFigure .

mantic:generatesTransitionTo a owl:ObjectProperty ;
    rdfs:label "generates transition to"@en ;
    rdfs:comment "Dynamic edge of the I Ching state machine: flipping the line at a given position transforms the source hexagram into the target. 64 nodes, 384 directed edges, strongly connected."@en ;
    rdfs:domain mantic:IChingHexagram ;
    rdfs:range mantic:IChingHexagram .

mantic:dominatesElement a owl:ObjectProperty ;
    rdfs:label "dominates element"@en ;
    rdfs:comment "Elemental attribution edge linking a figure to an elemental principle."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range mantic:Element .

mantic:resolvesAmbiguity a owl:ObjectProperty ;
    rdfs:label "resolves ambiguity"@en ;
    rdfs:comment "Binds a figure to the class of decision deadlock its counsel addresses (optimization plateau, Pareto-flatness, OOD surprise)."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range mantic:DecisionContext .

#################################################################
# Data properties
#################################################################

mantic:hasBinaryVector a owl:DatatypeProperty ;
    rdfs:label "binary vector"@en ;
    rdfs:comment "Canonical bit-string of the figure. Width: 4 (GeomanticSign), 6 (IChingHexagram), 8 (IfaOdu)."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range xsd:string .

mantic:figureIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "figure index"@en ;
    rdfs:comment "Seniority index within its system: King Wen number (hexagrams), tableau rank (geomancy), odu rank 1..256 (Ifa)."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range xsd:integer .

mantic:element a owl:DatatypeProperty ;
    rdfs:label "element"@en ;
    rdfs:comment "Literal elemental attribution mirroring mantic:dominatesElement for lightweight clients."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range xsd:string .

mantic:parable a owl:DatatypeProperty ;
    rdfs:label "parable"@en ;
    rdfs:comment "Cautionary archetypal counsel attached to the figure; the narrative kernel the oracle uses to reframe deadlocks."@en ;
    rdfs:domain mantic:ManticFigure ;
    rdfs:range xsd:string .

mantic:agentId a owl:DatatypeProperty ;
    rdfs:label "agent id"@en ;
    rdfs:domain mantic:Consultation ;
    rdfs:range xsd:string .

mantic:decisionText a owl:DatatypeProperty ;
    rdfs:label "decision text"@en ;
    rdfs:domain mantic:DecisionContext ;
    rdfs:range xsd:string .

mantic:castAt a owl:DatatypeProperty ;
    rdfs:label "cast at"@en ;
    rdfs:domain mantic:Consultation ;
    rdfs:range xsd:dateTime .

#################################################################
# Element individuals
#################################################################

mantic:ElemAir      a mantic:Element ; rdfs:label "Air"@en .
mantic:ElemFire     a mantic:Element ; rdfs:label "Fire"@en .
mantic:ElemWater    a mantic:Element ; rdfs:label "Water"@en .
mantic:ElemEarth    a mantic:Element ; rdfs:label "Earth"@en .
mantic:ElemHeaven   a mantic:Element ; rdfs:label "Heaven"@en .
mantic:ElemLake     a mantic:Element ; rdfs:label "Lake"@en .
mantic:ElemThunder  a mantic:Element ; rdfs:label "Thunder"@en .
mantic:ElemWind     a mantic:Element ; rdfs:label "Wind"@en .
mantic:ElemMountain a mantic:Element ; rdfs:label "Mountain"@en .

#################################################################
# Canonical decision-context individuals
#################################################################

mantic:Deadlock     a mantic:DecisionContext ; rdfs:label "Optimization deadlock"@en .
mantic:ParetoFlat   a mantic:DecisionContext ; rdfs:label "Pareto-flat choice set"@en .
mantic:OODSurprise  a mantic:DecisionContext ; rdfs:label "Out-of-distribution uncertainty"@en .
